    },
    {
      "name": "rush_matchup",
      "group": "style",
      "summary": "Rush EPA of the home offense against the away rush defense, minus the swap."
    },
    {
      "name": "pass_exposed",
      "group": "style",
      "summary": "Pass matchup weighted by each offense's passing share."
    },
    {
      "name": "rush_exposed",
      "group": "style",
      "summary": "Rush matchup weighted by each offense's rushing share."
    },
    {
      "name": "early_matchup",
      "group": "phase",
      "summary": "Early-down EPA matchup, first and second down."
    },
    {
      "name": "late_matchup",
      "group": "phase",
      "summary": "Late-down EPA matchup, third and fourth down."
    },
    {
      "name": "redzone_matchup",
      "group": "phase",
      "summary": "EPA matchup inside the opponent's 20."
    },
    {
      "name": "comp_matchup",
      "group": "phase",
      "summary": "EPA matchup on plays with pre-play win probability from 10% to 90%."
    },
    {
      "name": "success_matchup",
      "group": "rates",
      "summary": "Success-rate matchup."
    },
    {
      "name": "explosive_matchup",
      "group": "rates",
      "summary": "Explosiveness matchup, 20-yard passes and 10-yard runs."
    },
    {
      "name": "ypp_matchup",
      "group": "rates",
      "summary": "Yards-per-play matchup."
    },
    {
      "name": "turnover_matchup",
      "group": "ball",
      "summary": "Matchup of plays without an interception or a lost fumble."
    },
    {
      "name": "sack_matchup",
      "group": "ball",
      "summary": "Matchup of pass plays that are not sacks."
    },
    {
      "name": "pressure_matchup",
      "group": "ball",
      "summary": "Matchup of pass plays without a quarterback hit or a sack."
    },
    {
      "name": "penalty_matchup",
      "group": "ball",
      "summary": "Matchup of penalty yards, with a defensive penalty as a plus for the offense."
    },
    {
      "name": "start_matchup",
      "group": "drive",
      "summary": "Matchup of drive-start yards from the offense's own goal."
    },
    {
      "name": "ppd_matchup",
      "group": "drive",
      "summary": "Points-per-drive matchup."
    },
    {
      "name": "score_drive_matchup",
      "group": "drive",
      "summary": "Share of drives that end in a touchdown or a field goal."
    },
    {
      "name": "clean_drive_matchup",
      "group": "drive",
      "summary": "Share of drives that do not end in a turnover."
    },
    {
      "name": "st_matchup",
      "group": "special",
      "summary": "Special-teams EPA matchup on kickoffs, punts, field goals, and extra points."
    },
    {
      "name": "rest_diff",
      "group": "situation",
      "summary": "Home rest days minus away rest days, from the schedule."
    },
    {
      "name": "travel_diff",
      "group": "situation",
      "summary": "Away travel miles minus home travel miles, in thousands."
    },
    {
      "name": "wind_pass",
      "group": "situation",
      "summary": "Wind speed times how much more the away team passes."
    },
    {
      "name": "cold_pass",
      "group": "situation",
      "summary": "Degrees under 45, when a temperature is listed, times the away passing edge."
    },
    {
      "name": "qb_edge",
      "group": "personnel",
      "summary": "Shrunk career pass EPA of the expected home starter minus the away starter."
    },
    {
      "name": "out_diff",
      "group": "personnel",
      "summary": "Players ruled out for the away team minus players ruled out for the home team."
    }
  ],
